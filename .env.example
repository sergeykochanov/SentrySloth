# Set API key for your selected provider:
# For provider=grok (default):
# SENTRYSLOTH_GROK_API_KEY=
# For provider=gemini:
# SENTRYSLOTH_GEMINI_API_KEY=

# LLM settings (optional)
# SENTRYSLOTH_LLM_PROVIDER=grok
# SENTRYSLOTH_LLM_TRIAGE_MODEL=grok-4-1-fast-non-reasoning
# SENTRYSLOTH_LLM_ANALYSIS_MODEL=grok-4-1-fast-reasoning
# SENTRYSLOTH_LLM_SCHEDULER_WORKERS=4
# SENTRYSLOTH_LLM_QUEUE_MAX_SIZE=1000
# SENTRYSLOTH_LLM_MAX_REQUESTS_PER_MINUTE=120
# SENTRYSLOTH_LLM_MAX_TOKENS_PER_MINUTE=1000000
# SENTRYSLOTH_LLM_TRIAGE_MAX_INPUT_TOKENS=16000
# SENTRYSLOTH_LLM_ANALYSIS_MAX_INPUT_TOKENS=64000
# SENTRYSLOTH_LLM_MAX_RETRIES=5
# SENTRYSLOTH_LLM_CONNECT_TIMEOUT=10.0
# SENTRYSLOTH_LLM_READ_TIMEOUT=120.0
# SENTRYSLOTH_LLM_TOTAL_TIMEOUT=300.0
# SENTRYSLOTH_LLM_QUOTA_EXHAUSTED_MODE=fail_fast
# SENTRYSLOTH_LLM_QUOTA_FALLBACK_SECURITY_THRESHOLD=0.8

# If you prefer Gemini instead:
# SENTRYSLOTH_LLM_PROVIDER=gemini
# SENTRYSLOTH_LLM_TRIAGE_MODEL=gemini-2.5-flash
# SENTRYSLOTH_LLM_ANALYSIS_MODEL=gemini-2.5-pro

# (API keys are listed at the top of this file)

# Cache settings (optional)
# SENTRYSLOTH_CACHE_ENABLED=true
# SENTRYSLOTH_CACHE_DB_PATH=~/.cache/sentrysloth/cache.db
# SENTRYSLOTH_CACHE_REPO_PROFILE_ENABLED=true
# SENTRYSLOTH_CACHE_REPO_PROFILE_HISTORY_ENABLED=false
# SENTRYSLOTH_CACHE_REPO_PROFILE_MAX_CHARS=6000
# SENTRYSLOTH_CACHE_REPO_PROFILE_MAX_ITEMS=24
# SENTRYSLOTH_CACHE_REPO_PROFILE_BOOTSTRAP_MAX_FILES=20
# SENTRYSLOTH_CACHE_REPO_PROFILE_BOOTSTRAP_MAX_TREE_PATHS=500
# SENTRYSLOTH_CACHE_REPO_PROFILE_BOOTSTRAP_MAX_FILE_CHARS=4000

# Git clone location (optional)
# SENTRYSLOTH_CLONE_BASE_DIR=~/.cache/sentrysloth/repos
